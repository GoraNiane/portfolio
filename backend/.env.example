# Configuration du serveur
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Email de réception des messages
CONTACT_RECEIVER_EMAIL=goraniane35@gmail.com

# Configuration SMTP (Optionnel en développement, indispensable en production)
# Si non configuré, les messages seront simulés et affichés dans les logs du serveur
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Limite de requêtes anti-spam (nombre de requêtes max par 15 minutes)
RATE_LIMIT_MAX=5
